+                "excerpt", str(session), "--artifact-id", "HC1", "--text-file", str(text_file), "--json"
+            ).stdout
+        )
+        self.assertEqual(from_file["excerpt"], "held-out</em> sets")
+        self.assertEqual(
+            payload[from_file["excerpt_start"]:from_file["excerpt_end"]], b"held-out</em> sets"
+        )
